# ===================================================
# 小Ke商城 + Ragent 环境变量模板
# 用法：将需要的变量填入 IDEA Run Configuration 的 Environment variables
#       或显式设置进程环境变量；Spring Boot 不会自动读取根目录 .env
# 注意：.env 已被 .gitignore 忽略，切勿提交到仓库
# ===================================================

# ---------- 商城 MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xiaoke_mall
DB_USERNAME=xiaoke_app
DB_PASSWORD=change-me

# 仅 user/order 启用 JWT；使用密码学随机的至少32字节，进行Base64编码
XIAOKE_JWT_SECRET_BASE64=
# 后台角色权限：product/order显式启用；admin始终启用后台认证
XIAOKE_ADMIN_AUTH_ENABLED=true
# admin/product/order使用同一后台密钥，必须与买家JWT密钥不同
XIAOKE_ADMIN_JWT_SECRET_BASE64=
# 仅供隔离开发工具；商品写入及发货已不使用本地管理密钥
LOCAL_ADMIN_KEY=

# ---------- Ragent PostgreSQL ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=ragent
PG_USERNAME=postgres
PG_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------- RocketMQ ----------
# 注意：Broker 端口必须避开商城的 8080/8081/8082
ROCKETMQ_NAMESRV=127.0.0.1:9876
ROCKETMQ_BROKER_PORT=18080
ROCKETMQ_BROKER_VIP_PORT=18081
ROCKETMQ_BROKER_HA_PORT=18082

# ---------- 对象存储 RustFS (S3 兼容) ----------
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_AK=rustfsadmin
RUSTFS_SK=change-me

# ---------- 大模型服务商（务必替换为真实 Key，禁止提交到仓库） ----------
# 通义千问 DashScope：对话与重排
DASHSCOPE_API_KEY=sk-replace-me
# 硅基流动 SiliconFlow：向量化
SILICONFLOW_API_KEY=sk-replace-me
# AiHubMix：备用模型通道
AIHUBMIX_API_KEY=sk-replace-me

# ---------- 本地模型（可选，未使用可留空） ----------
OLLAMA_URL=http://localhost:11434

# ---------- 向量库（可选，默认使用 PostgreSQL） ----------
# 取值：pg | milvus
RAG_VECTOR_TYPE=pg
MILVUS_URI=http://localhost:19530

# ---------- 服务地址 ----------
RAGENT_BASE_URL=http://127.0.0.1:9090/api/ragent
RAGENT_MCP_URL=http://127.0.0.1:9099
# BFF 访问 Ragent 的 Sa-Token（无 Bearer 前缀）
RAGENT_TOKEN=replace-with-real-token

# 管理失败访问/敏感读取的独立安全日志目录，相对启动工作目录
XIAOKE_SECURITY_AUDIT_DIR=output/security-audit

# ---------- 支付宝沙箱（仅订单服务的 dev,alipay-sandbox 配置启用） ----------
XIAOKE_ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
XIAOKE_ALIPAY_APP_ID=
XIAOKE_ALIPAY_SELLER_ID=
XIAOKE_ALIPAY_PRIVATE_KEY=
XIAOKE_ALIPAY_PUBLIC_KEY=
# 使用能公网访问的专用 HTTPS 调试地址，路径为 /api/payment/alipay/notify
XIAOKE_ALIPAY_NOTIFY_URL=
XIAOKE_ALIPAY_BUYER_ORIGIN=http://127.0.0.1:5173
